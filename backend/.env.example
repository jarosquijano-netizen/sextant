# Copy to .env for local dev. Never commit .env.
DATABASE_URL=postgresql://postgres:password@localhost:5432/sextant
SEXTANT_API_KEY=your-secret-key-here
ANTHROPIC_API_KEY=sk-ant-...
# Comma-separated origins allowed by CORS (add Netlify URL when dashboard is deployed)
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
PORT=3000
